  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "palette-classic"}}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "id": 1,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "sum by (function_name) (rate(milvus_proxy_req_count{function_name=~\"Search|Query\",status=\"total\"}[$__rate_interval]))", "legendFormat": "{{function_name}}", "range": true, "refId": "A"}],
      "title": "Proxy Search / Query QPS", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "ms", "color": {"mode": "palette-classic"}}, "overrides": []},
