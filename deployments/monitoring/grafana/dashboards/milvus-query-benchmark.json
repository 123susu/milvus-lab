        {"editorMode": "code", "expr": "clamp_min(sum(rate(milvus_proxy_req_count{component=\"proxy\",function_name=\"Search\",collection_name=\"VDBBench\",status=\"total\"}[$__rate_interval])) - sum(rate(milvus_proxy_req_count{component=\"proxy\",function_name=\"Search\",collection_name=\"VDBBench\",status=\"success\"}[$__rate_interval])), 0)", "legendFormat": "Search failed/s", "range": true, "refId": "C"}
