        {"editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(milvus_proxy_req_latency_bucket{function_name=~\"Search|Query\"}[$__rate_interval])))", "legendFormat": "P95", "range": true, "refId": "B"},
        {"editorMode": "code", "expr": "histogram_quantile(0.99, sum by (le) (rate(milvus_proxy_req_latency_bucket{function_name=~\"Search|Query\"}[$__rate_interval])))", "legendFormat": "P99", "range": true, "refId": "C"}
      ],
      "title": "Proxy End-to-End Latency", "type": "timeseries"
    },
