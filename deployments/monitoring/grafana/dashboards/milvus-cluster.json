      "targets": [
        {"editorMode": "code", "expr": "sum by (name) (rate(container_blkio_device_usage_total{job=\"cadvisor\",container_label_com_docker_compose_project=\"milvus-cluster-local\",operation=\"Read\"}[$__rate_interval]))", "legendFormat": "{{name}} read", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum by (name) (rate(container_blkio_device_usage_total{job=\"cadvisor\",container_label_com_docker_compose_project=\"milvus-cluster-local\",operation=\"Write\"}[$__rate_interval]))", "legendFormat": "{{name}} write", "range": true, "refId": "B"}
      ],
      "title": "Storage I/O Bandwidth by Container",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
