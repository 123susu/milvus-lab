      "title": "OS Page Cache by Container",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Resident anonymous memory and Linux page cache. A large cache is normally healthy and reclaimable; compare it with working set and major faults before treating it as pressure.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "id": 11,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"editorMode": "code", "expr": "container_memory_rss{job=\"cadvisor\",container_label_com_docker_compose_project=\"milvus-cluster-local\"}", "legendFormat": "{{name}} RSS", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "container_memory_cache{job=\"cadvisor\",container_label_com_docker_compose_project=\"milvus-cluster-local\"}", "legendFormat": "{{name}} cache", "range": true, "refId": "B"}
      ],
      "title": "Memory Composition — RSS vs Page Cache",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Major page faults require storage access and are a practical signal that the active data/index working set is not resident in RAM. Sustained non-zero values during a warm benchmark deserve investigation.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 32},
      "id": 12,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "rate(container_memory_failures_total{job=\"cadvisor\",container_label_com_docker_compose_project=\"milvus-cluster-local\",failure_type=\"pgmajfault\",scope=\"container\"}[$__rate_interval])", "legendFormat": "{{name}}", "range": true, "refId": "A"}],
      "title": "Major Page Faults by Container",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Per-container block-device traffic. This is storage I/O bandwidth, not DRAM bandwidth; it helps identify cache misses that fall through to disk.",
