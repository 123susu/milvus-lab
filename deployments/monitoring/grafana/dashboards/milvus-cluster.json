    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Linux cgroup page-cache occupancy per container. This is operating-system file cache in RAM, not the CPU L1/L2/L3 cache.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "id": 10,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
