      "description": "Percentage of Linux CFS scheduling periods in which QueryNode wanted CPU time but was paused because its Docker CPU quota had been exhausted. Sustained values above 20% indicate material CPU quota pressure.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "max": 100,
          "min": 0,
          "thresholds": {
